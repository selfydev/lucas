{
	"name": "@lucas-ai/db",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"main": "./dist/src/index.js",
	"types": "./dist/src/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/src/index.d.ts",
			"import": "./dist/src/index.js"
		},
		"./client": {
			"types": "./dist/src/client.d.ts",
			"import": "./dist/src/client.js"
		},
		"./prisma/*": {
			"import": "./prisma/*",
			"types": "./prisma/*"
		}
	},
	"files": [
		"dist",
		"prisma"
	],
	"scripts": {
		"build": "bun run db:generate && tsc -b && cp -R prisma dist/prisma",
		"check-types": "tsc -b",
		"db:generate": "bun run scripts/run-prisma-generate.ts",
		"db:migrate": "PRISMA_CONFIG_PATH=./prisma.config.ts prisma migrate dev",
		"db:migrate:deploy": "PRISMA_CONFIG_PATH=./prisma.config.ts bunx prisma migrate deploy",
		"db:push": "PRISMA_CONFIG_PATH=./prisma.config.ts prisma db push",
		"db:studio": "PRISMA_CONFIG_PATH=./prisma.config.ts prisma studio",
		"db:seed": "bun run scripts/seed.ts"
	},
	"dependencies": {
		"@prisma/adapter-pg": "^7.1.0",
		"prisma": "^7.1.0",
		"@prisma/client": "^7.1.0",
		"@prisma/client-runtime-utils": "7.1.0",
		"zod": "^4.1.13",
		"dotenv": "^17.2.3",
		"decimal.js": "^10.6.0"
	},
	"devDependencies": {
		"typescript": "^5.9.3"
	}
}
