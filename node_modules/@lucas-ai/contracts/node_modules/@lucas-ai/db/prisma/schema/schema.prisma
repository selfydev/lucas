// ==================== CONFIGURATION ====================
generator client {
  provider     = "prisma-client"
  output       = "../generated"
  moduleFormat = "esm"
  runtime      = "bun"
  engineType   = "client"
}

datasource db {
  provider = "postgresql"
}

// ==================== ENUMS ====================
enum UserRole {
  STUDENT
  COUNSELOR
  UNIVERSITY_ADMIN
  ADMIN
}

enum AddressType {
  HOME
  MAILING
  CAMPUS
  OTHER
}

enum TestIntent {
  SUBMIT
  NO_SCORE
}

enum TestPolicy {
  REQUIRED
  OPTIONAL
  NOT_CONSIDERED
}

enum HighSchoolSource {
  PUBLIC
  PRIVATE
  NCES_CCD
  NCES_PSS
  OPENDATASOFT_PUBLIC
  OPENDATASOFT_PRIVATE
  URBAN_INSTITUTE
}

enum StudentCollegeSource {
  SELECTED
  WILDCARD
}

enum AdmissionLabel {
  REACH
  TARGET
  LIKELY
  SAFETY
}

enum ImageEntityType {
  USER
  UNIVERSITY
}

enum ImageProvider {
  CLOUDFLARE_IMAGES
}

enum ImageType {
  LOGO
  BANNER
  CAMPUS_PHOTO
  PROFILE_PHOTO
}

enum MessagingChannelStatus {
  ACTIVE
  DISABLED
}

enum MessagingChannelCapability {
  TEXT
  MEDIA
}

enum MessagingMessageDirection {
  INBOUND
  OUTBOUND
}

enum MessagingMessageState {
  RECEIVED
  PROCESSED
  REPLY_QUEUED
  SENT
  DELIVERED
  FAILED
}

enum MessagingDeliveryStatus {
  SENT
  DELIVERED
  FAILED
}

enum MessagingIdempotencyType {
  INBOUND
  OUTBOUND
  RECEIPT
}

enum MessagingClarificationStatus {
  PENDING
  ANSWERED
}

enum SelectivityTier {
  MOST_SELECTIVE
  HIGHLY_SELECTIVE
  SELECTIVE
  MODERATELY_SELECTIVE
  MINIMALLY_SELECTIVE
  OPEN_ADMISSION
}

enum SizeBucket {
  VERY_SMALL
  SMALL
  MEDIUM
  LARGE
  VERY_LARGE
}

enum PrestigeTier {
  ELITE
  HIGHLY_RANKED
  WELL_REGARDED
  REGIONAL
  STANDARD
}

enum ApplicationDeadlineType {
  /// Early Decision I
  ED
  /// Early Decision II
  EDII
  /// Early Action I
  EA
  /// Early Action II
  EAII
  /// Restrictive Early Action
  REA
  /// Regular Decision
  RD
  /// Rolling admissions (no fixed date)
  ROLLING
}

enum ApplicationEssayType {
  /// Common App personal statement prompt
  COMMON_APP
  /// School-specific supplement prompt
  SUPPLEMENT
  /// Program-specific prompt (e.g., honors, major)
  PROGRAM
}

// ==================== SHARED MODELS ====================

model Address {
  id        String   @id @default(cuid(2))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  type       AddressType @default(HOME)
  street     String?
  street2    String?
  city       String
  state      String      @db.VarChar(2)
  postalCode String
  country    String      @default("US") @db.VarChar(2)

  // Geolocation
  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  // Polymorphic associations
  userId       String?
  universityId Int?
  highSchoolId String?

  user       User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  university University? @relation(fields: [universityId], references: [unitid], onDelete: Cascade)
  highSchool HighSchool? @relation(fields: [highSchoolId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([universityId])
  @@index([highSchoolId])
  @@index([state])
  @@index([latitude, longitude])
}

// ==================== STUDENT DOMAIN ====================

model StudentProfile {
  id        String   @id @default(cuid(2))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Residency for in-state calculations
  stateOfResidence String? @db.VarChar(2)

  // Academic info (structured)
  highSchool     String?
  highSchoolId   String?
  graduationYear Int?
  gpaUnweighted  Decimal? @db.Decimal(3, 2)

  // Standardized tests
  testIntent   TestIntent?
  satTotal     Int?
  satEbrw      Int?
  satMath      Int?
  actComposite Int?

  // Course rigor (0-1 scale)
  rigorLevel  Decimal? @db.Decimal(3, 2)

  // Holistic factors (0-1 scales)
  extracurricularScore         Decimal? @db.Decimal(3, 2)
  extracurricularAcknowledgedNone Boolean @default(false)
  extracurricularConversationId String? @unique

  // Background/Hooks
  firstGeneration  Boolean @default(false)
  legacyColleges   Json? // Array of unitids
  recruitedAthlete Boolean @default(false)

  // Extended profile (flexible JSON for future)
  extendedProfile       Json? // Activities, awards, interests, etc.
  schemaVersion         String    @default("student.v2")
  onboardingStep        String?   @db.VarChar(32)
  onboardingCompletedAt DateTime?
  onboardingSnapshot    Json?

  // Relations
  highSchoolRecord   HighSchool?               @relation("StudentProfileHighSchool", fields: [highSchoolId], references: [id], onDelete: SetNull)
  admissionRuns      AdmissionRun[]
  targetUniversities StudentTargetUniversity[]
  interestTags       StudentInterestTag[]
  extracurriculars   StudentExtracurricular[]
  extracurricularConversation AIConversation? @relation("StudentProfileExtracurricularConversation", fields: [extracurricularConversationId], references: [id], onDelete: SetNull)

  @@index([stateOfResidence])
  @@index([graduationYear])
  @@index([highSchoolId])
}

model StudentExtracurricular {
  id        String   @id @default(cuid(2))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  activityId String
  sortOrder  Int     @default(0)
  title      String
  category   String
  roleLevel  String
  impactLevel String

  hoursPerWeek Int?
  weeksPerYear Int?
  startGrade   Int?
  endGrade     Int?
  isPaidOrCaregiving Boolean?
  summary      String?

  conversationId String?
  conversation   AIConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@unique([studentProfileId, activityId])
  @@index([studentProfileId])
  @@index([conversationId])
}

model HighSchool {
  id         String   @id @default(cuid(2))
  externalId String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  source     HighSchoolSource
  ncesId     String?
  privateId  String?
  name       String
  city       String?
  state      String?          @db.VarChar(2)
  postalCode String?
  country    String           @default("US") @db.VarChar(2)
  latitude   Decimal?         @db.Decimal(10, 7)
  longitude  Decimal?         @db.Decimal(10, 7)
  lowGrade   String?
  highGrade  String?
  phone      String?
  website    String?
  metadata   Json?

  // Data source tracking
  lastSyncedAt     DateTime?
  isAuthoritative  Boolean          @default(false)

  addresses Address[]
  students  StudentProfile[]          @relation("StudentProfileHighSchool")

  @@index([ncesId])
  @@index([privateId])
  @@index([state])
  @@index([city])
  @@index([name])
  @@index([name(ops: raw("gin_trgm_ops"))], map: "HighSchool_name_trgm_idx", type: Gin)
  @@index([latitude, longitude])
  @@index([source])
  @@index([isAuthoritative])
  @@index([lastSyncedAt])
}

// ==================== UNIVERSITY DOMAIN ====================

model University {
  unitid    Int      @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Core identifiers
  name     String
  state    String  @db.VarChar(2)
  isPublic Boolean

  // Location (structured)
  city               String?
  website            String?
  priceCalculatorUrl String?
  googlePlaceId      String? @db.VarChar(255)

  // Latest data year
  latestDataYear Int?

  profile       Json // Flexible university profile data
  schemaVersion String @default("university.v2")

  // Classification (Phase 2)
  carnegieBasic       Int?
  carnegieUndergrad   Int?
  carnegieSizeSetting Int?
  locale              Int? // IPEDS locale code
  regionId            Int?

  // Demographics (Phase 2)
  religiousAffiliation    Int?
  minorityServingHbcu     Boolean @default(false)
  minorityServingHispanic Boolean @default(false)
  minorityServingTribal   Boolean @default(false)
  minorityServingAapi     Boolean @default(false)

  // Enrollment & Outcomes (Phase 2)
  studentSize        Int?
  retentionRate      Decimal? @db.Decimal(6, 5)
  avgNetPrice        Decimal? @db.Decimal(10, 2)
  medianEarnings10yr Decimal? @db.Decimal(10, 2)
  completionRate     Decimal? @db.Decimal(6, 5)

  // Computed Classifications (Phase 2)
  isFlagship      Boolean          @default(false)
  selectivityTier SelectivityTier?
  sizeBucket      SizeBucket?
  prestigeTier    PrestigeTier?
  popularityScore Decimal?         @db.Decimal(6, 2)

  // Relations
  addresses        Address[]
  stats            UniversityStats[]
  projection       UniversityProjection?
  admissionResults AdmissionResult[]
  images           Image[]
  tags             UniversityTagAssignment[]
  aliases          UniversityAlias[]
  roiData          UniversityROI?

  applicationData ApplicationData[]
  studentTargets     StudentTargetUniversity[]

  @@index([state])
  @@index([isPublic])
  @@index([name(ops: raw("gin_trgm_ops"))], map: "University_name_trgm_idx", type: Gin)
  @@index([googlePlaceId])
}

model ApplicationData {
  id        String   @id @default(cuid(2))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  unitid     Int
  university University @relation(fields: [unitid], references: [unitid], onDelete: Cascade)

  cycleLabel String
  memberId   String?

  deadlines ApplicationDeadline[]
  essays    ApplicationEssay[]

  @@unique([unitid, cycleLabel])
  @@index([memberId])
}

model ApplicationDeadline {
  id        String   @id @default(cuid(2))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applicationDataId String
  applicationData   ApplicationData @relation(fields: [applicationDataId], references: [id], onDelete: Cascade)

  type        ApplicationDeadlineType
  deadlineAt  DateTime?
  description String?

  @@unique([applicationDataId, type])
  @@index([type])
}

model ApplicationEssay {
  id        String   @id @default(cuid(2))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applicationDataId String
  applicationData   ApplicationData @relation(fields: [applicationDataId], references: [id], onDelete: Cascade)

  promptId     String?
  type         ApplicationEssayType
  prompt       String
  required     Boolean @default(false)
  minWords     Int?
  maxWords     Int?
  topic        String?
  sourceUrl    String?
  instructions String?

  @@index([applicationDataId])
}

model UniversityTag {
  id        String   @id @default(cuid(2))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slug        String  @unique
  name        String
  description String?

  assignments      UniversityTagAssignment[]
  studentInterests StudentInterestTag[]
}

model UniversityTagAssignment {
  universityId Int
  tagId        String
  createdAt    DateTime @default(now())

  university University    @relation(fields: [universityId], references: [unitid], onDelete: Cascade)
  tag        UniversityTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([universityId, tagId])
  @@index([tagId])
}

model UniversityAlias {
  id        String   @id @default(cuid(2))
  createdAt DateTime @default(now())

  universityId Int
  university   University @relation(fields: [universityId], references: [unitid], onDelete: Cascade)

  alias     String
  isPrimary Boolean @default(false)
  aliasType String? // "official", "nickname", "abbreviation", "historical"

  @@unique([universityId, alias])
  @@index([alias])
  @@index([universityId])
}

model UniversityROI {
  id        String   @id @default(cuid(2))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  universityId Int        @unique
  university   University @relation(fields: [universityId], references: [unitid], onDelete: Cascade)

  dataYear    String // "2021-22"
  degreeLevel String // "Bachelor's"

  roi10yr Decimal? @db.Decimal(12, 0)
  roi15yr Decimal? @db.Decimal(12, 0)
  roi20yr Decimal? @db.Decimal(12, 0)
  roi30yr Decimal? @db.Decimal(12, 0)
  roi40yr Decimal? @db.Decimal(12, 0)

  @@index([universityId])
}

model StudentTargetUniversity {
  id        String   @id @default(cuid(2))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentId    String
  universityId Int
  source       StudentCollegeSource @default(SELECTED)
  position     Int?

  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  university University     @relation(fields: [universityId], references: [unitid], onDelete: Cascade)

  @@unique([studentId, universityId, source])
  @@index([studentId])
  @@index([source])
}

model StudentInterestTag {
  studentId String
  tagId     String
  createdAt DateTime @default(now())

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tag     UniversityTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([studentId, tagId])
  @@index([tagId])
}

model UniversityStats {
  id        String   @id @default(cuid(2))
  createdAt DateTime @default(now())

  universityId Int
  university   University @relation(fields: [universityId], references: [unitid], onDelete: Cascade)

  year Int

  // Statistics snapshot
  stats         Json // All stats for this year
  schemaVersion String @default("stats.v1")

  // Data source tracking
  dataSource    String? // "scorecard", "cds", "ipeds"
  dataSourceUrl String?

  @@unique([universityId, year])
  @@index([year])
}

model UniversityProjection {
  id        String   @id @default(cuid(2))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  universityId Int        @unique
  university   University @relation(fields: [universityId], references: [unitid], onDelete: Cascade)

  year Int @default(0)

  // Denormalized admission rates for fast scoring
  admitRateOverall    Decimal? @db.Decimal(6, 5)
  admitRateInState    Decimal? @db.Decimal(6, 5)
  admitRateOutOfState Decimal? @db.Decimal(6, 5)

  // Test score percentiles
  satComposite25 Int?
  satComposite75 Int?
  satEbrw25      Int?
  satEbrw75      Int?
  satMath25      Int?
  satMath75      Int?

  actComposite25 Int?
  actComposite75 Int?
  actEnglish25   Int?
  actEnglish75   Int?
  actMath25      Int?
  actMath75      Int?

  // Academic
  avgAdmittedGPA Decimal?    @db.Decimal(4, 3)
  testPolicy     TestPolicy?

  // CDS C7 importance factors
  c7Rigor            String?
  c7Gpa              String?
  c7Tests            String?
  c7Essay            String?
  c7Recommendations  String?
  c7Extracurriculars String?

  // Residency distribution
  residencySplitInState Decimal? @db.Decimal(6, 5)
  residencySplitOut     Decimal? @db.Decimal(6, 5)

  // Metadata
  dataVersion String?

  @@index([year])
  @@index([admitRateOverall])
  @@index([testPolicy])
}

// ==================== SCORING & ADMISSIONS ====================

model AdmissionRun {
  id          String    @id @default(cuid(2))
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  // Link to student
  studentId String?
  student   StudentProfile? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  // Snapshot of student profile used
  studentSnapshot Json

  // Scoring configuration
  scoringVersion String
  scoringOptions Json? // k-value, weights, etc.

  // Run metadata
  requestedBy String? // User ID who triggered

  // Results
  results AdmissionResult[]

  @@index([studentId])
  @@index([createdAt])
  @@index([scoringVersion])
}

model AdmissionResult {
  id        String   @id @default(cuid(2))
  createdAt DateTime @default(now())

  runId String
  run   AdmissionRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  universityId Int
  university   University @relation(fields: [universityId], references: [unitid], onDelete: Cascade)

  // Core scoring results
  probability Decimal        @db.Decimal(6, 5)
  score10     Decimal        @db.Decimal(4, 2)
  label       AdmissionLabel

  // Detailed breakdown
  breakdown     Json // Factor contributions
  baselineLogit Decimal? @db.Decimal(8, 5)

  @@index([runId])
  @@index([universityId])
  @@index([label])
}

// ==================== ETL & SYNC ====================

model SyncJob {
  id     String @id @default(cuid(2))
  type   String // "scorecard_sync", "cds_sync", etc.
  status String @default("pending") // pending, in_progress, completed, failed

  message     String?
  initiatedBy String?

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  metadata         Json? // Additional job metadata
  recordsProcessed Int?
  recordsFailed    Int?

  @@index([type, startedAt(sort: Desc)])
  @@index([status])
}

// ==================== MEDIA ====================

model Image {
  id        String   @id @default(cuid(2))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entityType ImageEntityType
  entityId   String
  sortOrder  Int             @default(0)

  imageType   ImageType?
  isFeatured  Boolean    @default(false)

  label    String?
  altText  String?
  caption  String?
  metadata Json?

  provider          ImageProvider @default(CLOUDFLARE_IMAGES)
  providerImageId   String
  requireSignedUrls Boolean       @default(false)

  filename    String?
  contentType String?
  fileSize    Int?
  width       Int?
  height      Int?
  checksum    String?
  uploadedAt  DateTime?

  variantNames String[] @default([])

  originalStorageKey String?
  originalBucket     String?
  originalChecksum   String?
  originalFileSize   Int?

  userId       String?
  universityId Int?

  user       User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  university University? @relation(fields: [universityId], references: [unitid], onDelete: Cascade)

  @@unique([provider, providerImageId])
  @@unique([entityType, entityId, sortOrder])
  @@index([entityType, entityId])
  @@index([entityType, entityId, sortOrder])
  @@index([entityType, entityId, isFeatured])
  @@index([entityType, entityId, imageType])
  @@index([userId])
  @@index([universityId])
}

// ==================== MESSAGING ====================

model MessagingChannel {
  id        String   @id @default(cuid(2))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  label        String?
  phone        String   @unique
  status       MessagingChannelStatus        @default(ACTIVE)
  capabilities MessagingChannelCapability[]  @default([])

  messages      MessagingMessage[]
  conversations MessagingConversation[]

  @@index([status])
}

model MessagingParticipant {
  id        String   @id @default(cuid(2))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  handle String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  conversations MessagingConversation[]
  messages      MessagingMessage[]

  @@index([userId])
}

model MessagingConversation {
  id        String   @id @default(cuid(2))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  channelId     String
  participantId String
  lastMessageAt DateTime?

  channel     MessagingChannel    @relation(fields: [channelId], references: [id], onDelete: Cascade)
  participant MessagingParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  messages    MessagingMessage[]
  clarifications MessagingClarification[]

  @@unique([channelId, participantId])
  @@index([channelId])
  @@index([participantId])
  @@index([lastMessageAt])
}

model MessagingMessage {
  id        String   @id @default(cuid(2))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversationId String
  channelId      String
  participantId  String

  direction MessagingMessageDirection
  state     MessagingMessageState      @default(RECEIVED)

  externalId  String   @unique
  body        String?
  media       Json?
  metadata    Json?
  timestamp   DateTime?
  commandId   String?

  channel     MessagingChannel     @relation(fields: [channelId], references: [id], onDelete: Cascade)
  participant MessagingParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  conversation MessagingConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  deliveries   MessagingDelivery[]
  clarifications MessagingClarification[] @relation("ClarificationAskedMessage")

  @@index([channelId, createdAt])
  @@index([participantId, createdAt])
  @@index([conversationId, createdAt])
  @@index([state])
}

model MessagingDelivery {
  id        String   @id @default(cuid(2))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messageId String
  commandId String
  status    MessagingDeliveryStatus
  error     String?
  deliveredAt DateTime?
  failedAt    DateTime?
  channelId   String?
  handle      String?

  message MessagingMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([commandId])
  @@index([messageId])
  @@index([status])
  @@index([createdAt])
}

model MessagingIdempotency {
  id         String   @id @default(cuid(2))
  createdAt  DateTime @default(now())
  key        String   @unique
  type       MessagingIdempotencyType
  lastSeenAt DateTime @default(now())
}

model MessagingClarification {
  id        String   @id @default(cuid(2))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversationId String
  askedMessageId String
  status        MessagingClarificationStatus @default(PENDING)
  clarificationHint String?

  // Store original triage intent for resumption after clarification
  originalMode         String?
  originalToolsLikely  String[] @default([])
  originalDeepAnalysis Boolean  @default(false)

  conversation MessagingConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  askedMessage MessagingMessage @relation("ClarificationAskedMessage", fields: [askedMessageId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([status])
  @@index([conversationId, status])
}

// ==================== AI CONVERSATIONS ====================

model AIConversation {
  id        String   @id @default(cuid(2))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  type   String // 'extracurricular', 'essay-review', etc.

  messages                AIMessage[]
  studentProfile          StudentProfile?          @relation("StudentProfileExtracurricularConversation")
  extracurricularEntries  StudentExtracurricular[]

  @@unique([userId, type])
  @@index([userId])
  @@index([type])
}

model AIMessage {
  id        String   @id @default(cuid(2))
  createdAt DateTime @default(now())

  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role String // 'user' | 'assistant' | 'system'

  parts AIMessagePart[]

  @@index([conversationId])
  @@index([createdAt])
}

model AIMessagePart {
  id        String   @id @default(cuid(2))
  createdAt DateTime @default(now())

  messageId String
  message   AIMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  type  String // 'text' | 'tool-call' | 'tool-result' | 'data'
  order Int

  // Prefix-based columns following AI SDK pattern
  text_content String?

  // Tool call fields
  tool_callId String?
  tool_name   String?
  tool_input  Json?

  // Tool result fields
  tool_result Json?

  // Custom data fields
  data_type    String?
  data_content Json?

  @@unique([messageId, order])
  @@index([messageId])
  @@index([type])
}
