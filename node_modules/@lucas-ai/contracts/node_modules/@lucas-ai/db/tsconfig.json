{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"skipLibCheck": true,
		"declaration": true,
		"declarationMap": true,
		"emitDeclarationOnly": false,
		"outDir": "./dist",
		"rootDir": ".",
		"composite": true,
		"verbatimModuleSyntax": true
	},
	"include": [
		"src/**/*",
		"prisma/generated/**/*.ts",
		"prisma/generated/**/*.d.ts"
	]
}
